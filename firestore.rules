rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo-level rule: anyone with the exact family code (document id) can
    // read/write that family's document. Good enough for a project/hackathon
    // demo. For real production use, add Firebase Auth and scope access to
    // signed-in parent/student uids stored on the family document instead.
    match /families/{code} {
      allow read, write: if true;
    }
  }
}
